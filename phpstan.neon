includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 9
    paths:
        - src
        - tests
        # Migrations were outside analysis, which made the "PHPStan is clean"
        # gate vacuous for the only code in the package that can destroy data.
        - database

services:
    -
        class: Fissible\Vouch\Tests\PHPStan\PestTestCallMixinExtension
        tags:
            - phpstan.broker.methodsClassReflectionExtension
